# ==========================================
# CONFIGURACIÓN GENERAL DEL MONOREPO (AsistApp)
# ==========================================

# ------------------------------------------
# CONFIGURACIÓN SUPABASE (Local o Cloud)
# ------------------------------------------
# Para desarrollo local (Supabase CLI / Docker):
# URL por defecto: http://localhost:54321
# Para producción/nube: Usar valores de app.supabase.com
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# CONFIGURACIÓN BACKEND (NestJS)
# ------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-for-nestjs
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ------------------------------------------
# CONFIGURACIÓN FRONTEND (Next.js)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------
# CREDENCIALES DE PROVEEDORES SSO (Opcional - Fase 1/2)
# ------------------------------------------
AUTH_GOOGLE_CLIENT_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

