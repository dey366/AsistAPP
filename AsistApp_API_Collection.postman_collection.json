		{
			"name": "Asistencias (Control)",
			"item": [
				{
					"name": "Obtener estudiantes y su estado de asistencia",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/attendance/schedule/:scheduleId/date/:date",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"attendance",
								"schedule",
								":scheduleId",
								"date",
								":date"
							],
							"variable": [
								{
									"key": "scheduleId",
									"value": "uuid-del-horario"
								},
								{
									"key": "date",
									"value": "2026-05-20"
								}
							]
						},
						"description": "Devuelve la lista de estudiantes inscritos y sus actas de firma previas."
					},
					"response": []
				},
				{
					"name": "Registrar o actualizar asistencia en bloque",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"scheduleId\": \"uuid-del-horario-aqui\",\n  \"date\": \"2026-05-20\",\n  \"records\": [\n    {\n      \"studentId\": \"uuid-del-estudiante-1\",\n      \"status\": \"presente\"\n    },\n    {\n      \"studentId\": \"uuid-del-estudiante-2\",\n      \"status\": \"tarde\",\n      \"delayMinutes\": 18\n    },\n    {\n      \"studentId\": \"uuid-del-estudiante-3\",\n      \"status\": \"ausente\"\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/attendance/bulk",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"attendance",
								"bulk"
							]
						},
						"description": "Registra el lote oficial de asistencias procesando tolerancias y umbrales de inasistencias en el backend."
					},
					"response": []
				}
			]
		},
